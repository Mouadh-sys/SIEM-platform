# Environment Variables for SIEM Project
COMPOSE_PROJECT_NAME=siem-lab

# Versions
OPENSEARCH_VERSION=2.18.0
OPENSEARCH_DASHBOARDS_VERSION=2.18.0
KAFKA_VERSION=3.8.0
DATA_PREPPER_VERSION=2.10.1
FLUENT_BIT_VERSION=3.2.2

# Ports
OPENSEARCH_PORT=9200
DASHBOARDS_PORT=5601
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
FASTAPI_PORT=8000
FRONTEND_PORT=5173
SSH_TARGET_PORT=2222

# OpenSearch Configuration
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
DISABLE_SECURITY_PLUGIN=true

# Kafka Configuration
KAFKA_CLUSTER_ID=4L622nShTJiAusfdINVVOg
KAFKA_TOPIC=security-logs
